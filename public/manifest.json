{
  "name": "Snippet Bubbles",
  "short_name": "Snippets",
  "description": "AI-powered code snippet manager with generation, explanation, and conversion",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0a7ea4",
  "background_color": "#ffffff",
  "categories": ["productivity", "developer"],
  "screenshots": [
    {
      "src": "/assets/images/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/assets/images/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/assets/images/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Generate Snippet",
      "short_name": "Generate",
      "description": "Create a new snippet with AI",
      "url": "/?tab=ai",
      "icons": [
        {
          "src": "/assets/images/icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Library",
      "short_name": "Library",
      "description": "View all your snippets",
      "url": "/?tab=library",
      "icons": [
        {
          "src": "/assets/images/icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "code",
          "accept": ["text/plain", "application/json"]
        }
      ]
    }
  }
}
